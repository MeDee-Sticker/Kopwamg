# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้ามคอมมิตไฟล์ .env
# วิธีขอค่าทั้งหมด: setup/01-facebook-page.md

# แอป Meta (App Settings → Basic)
FB_APP_ID=
FB_APP_SECRET=

# เพจและ Page access token (ได้จาก: python3 scripts/fb_scheduler.py --exchange-token "...")
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# เวอร์ชัน Graph API ที่แอปของคุณเปิดใช้ (เว้นว่างได้)
FB_GRAPH_VERSION=v26.0

# Google Gemini — รันพร้อมต์สคริปต์จริงด้วย scripts/gemini_prompt_runner.py
# ขอ key ที่ https://aistudio.google.com/apikey (ห้ามคอมมิตไฟล์ .env)
GEMINI_API_KEY=
# เลือกโมเดลเองได้ (เว้นว่าง = gemini-3.8-flash)
GEMINI_MODEL=
# เปลี่ยนปลายทางชั่วคราวสำหรับทดสอบ (ปกติไม่ต้องตั้ง)
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
